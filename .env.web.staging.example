# Web staging vars for `develop` Preview deployments.
# Copy to `.env.web.staging` (ignored) and fill in values.

EXPO_PUBLIC_API_BASE_URL=https://api-grwyler-grwylers-projects.vercel.app/api/v1

# OAuth (public Expo env vars - Google)
EXPO_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_OAUTH_REDIRECT_URI=https://setwisefit-test.vercel.app

# Optional observability (recommended)
# EXPO_PUBLIC_SENTRY_DSN=https://...
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=staging
# EXPO_PUBLIC_SENTRY_RELEASE=
# EXPO_PUBLIC_OBSERVABILITY_ENABLED=true
